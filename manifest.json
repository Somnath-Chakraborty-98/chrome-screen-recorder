{
  "manifest_version": 3,
  "name": "RecordEasy — Screen Recorder",
  "description": "Record screen and audio with plan-based quality, MP4, and meeting tools. Run npm run build before loading.",
  "version": "1.2.2",
  "action": {
    "default_popup": "dist/src/presentation/popup/popup.html",
    "default_title": "RecordEasy"
  },
  "permissions": [
    "tabCapture",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://guiupuhxcdoehxulaygv.supabase.co/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.teams.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.live.com/*"
      ],
      "js": ["dist/src/application/content/content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "dist/src/application/background/background.js"
  },
  "icons": {
    "16": "dist/icons/icon16.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  }
}
